
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Report {
  id        Int      @id @default(autoincrement())
  lat       Float
  lng       Float
  imageUrl  String
  issueType String
  severity  Float
  status    String   @default("pending")
  assignedTo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reports")
}